export default "query PawmateQuery(\n    $affection: Int,\n    $activityLevel: Int,\n    $attractiveness: Int,\n    $bodySize: Int,\n    $hairyness: Int,\n    $diet: Int,\n) {\n    pawmateResolveMatches(\n        affection: $affection\n        activityLevel: $activityLevel\n        attractiveness: $attractiveness\n        bodySize: $bodySize\n        hairyness: $hairyness\n        diet: $diet\n    ) {\n        id\n        title\n        age\n        sex\n        neutered\n        shortDescription\n        imageUrl,\n        affection\n        activityLevel\n        bodySize\n        hairyness\n        diet\n        attractiveness\n        matchPercentage\n    }\n}\n\n"