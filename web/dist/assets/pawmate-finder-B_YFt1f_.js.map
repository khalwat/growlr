export default "query UserQuery($id: [QueryArgument]) {\n    users(limit: 1, id: $id) {\n        ... on User {\n            id\n            username\n            fullName\n            photo {\n                url\n            }\n            affection\n            activityLevel\n            bodySize\n            hairyness\n            diet\n            attractiveness\n        }\n    }\n}\n"