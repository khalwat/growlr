{% extends "vendor/nystudio107/craft-twig-base-templates/templates/_layouts/html-page.twig" %}

{% block headScripts %}
    {{ craft.vite.script("src/js/app.ts") }}
    {{ craft.vite.script("src/js/welcome.ts") }}
{% endblock headScripts %}

{% block headLinks %}
{% endblock %}

{# -- Content that appears before the primary content block -- #}
{% block preContent %}
    {{ craft.vite.integrity("src/js/app.ts") }}

    <div id="app-container"></div>
    <section>
        <h3>preContent</h3>
    </section>
{% endblock %}

    {# -- Primary content block -- #}
    {% block content %}
        <section>
            <h1>{{ entry.title }}</h1>
            <h3>content</h3>
        </section>

        </pre>

    {% endblock %}

    {# -- Content that appears after the primary content block -- #}
    {% block postContent %}
        <section>
            <h3>postContent</h3>
        </section>
    {% endblock %}

    {# -- Any <script></script> tags that should be included before </body> -- #}
    {% block bodyScripts %}
        {{ parent() }}
    {% endblock bodyScripts %}
