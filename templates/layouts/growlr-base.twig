{% extends "vendor/nystudio107/craft-twig-base-templates/templates/_layouts/html-page.twig" %}

{% block bodyTag %}
<body class="bg-gradient-to-b from-yellow-100 to-yellow-600">
{% endblock bodyTag %}

{% block headScripts %}
    {{ craft.vite.script("src/js/app.ts", false) }}
    {{ craft.vite.script("src/js/users-menu.ts", false) }}
{% endblock headScripts %}

{% block preContent %}
    <section>
        <div class="flex flex-row-reverse">
            <div class="w-14">
                <div id="users-menu-container"></div>
            </div>
        </div>
        <div class="flex justify-center">
            <div class="w-96 animate-[spin_.4s_ease-in-out]">
                <a href="/">
                    <img class="h-auto max-w-full" src="/assets/growlr-logo.png"/>
                </a>
            </div>
        </div>
        <div class="flex justify-center">
            <div class="text-lg">
                The purrfect match from nose to toes
            </div>
        </div>
    </section>
{% endblock preContent %}
